{
  "name": "examdee-game",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:push": "drizzle-kit push --force",
    "db:seed": "tsx --env-file=.env db/seed.ts",
